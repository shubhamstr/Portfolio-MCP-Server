# Copy this to .env and fill in values before running locally or on server
PORT=9001

# Optional API Key for securing /mcp when running in HTTP mode.
# If set, clients must pass this key via:
#   - Header: 'x-api-key: your-secret-api-key'
#   - Header: 'Authorization: Bearer your-secret-api-key'
#   - Query Param: http://localhost:9001/mcp?apiKey=your-secret-api-key
# If left empty/unset, the /mcp endpoint remains publicly accessible.
MCP_API_KEY=your-secret-api-key
